# Copia questo file in `.env` e compila i valori.
#
# Serve al percorso DOCKER: `docker-compose.yml` legge le chiavi da variabili
# d'ambiente (`${CEREBRAS_API_KEY:-}` ecc.) e Docker Compose le prende da questo
# file. Non usare `.streamlit/secrets.toml` per Docker: quel path è escluso dal
# build context in `.dockerignore` e il container non lo vedrebbe.
#
# Per l'esecuzione LOCALE senza Docker vale invece
# `.streamlit/secrets.toml` (template in `.streamlit/secrets.toml.example`).
#
# `.env` è in .gitignore e NON va mai committato.

# Provider AI attivo: cerebras | groq | openai | openrouter | anthropic | gemini
AI_PROVIDER=cerebras

# Imposta SOLO le chiavi dei provider che vuoi usare (almeno una).
CEREBRAS_API_KEY=          # https://cloud.cerebras.ai
GROQ_API_KEY=              # https://console.groq.com
OPENAI_API_KEY=            # https://platform.openai.com
OPENROUTER_API_KEY=        # https://openrouter.ai
ANTHROPIC_API_KEY=         # https://console.anthropic.com
GEMINI_API_KEY=            # https://aistudio.google.com

# Password per accedere alla dashboard
APP_PASSWORD=cambiami

# eBay Browse API (opzionale: senza, eBay usa fallback HTML e prende 403)
EBAY_APP_ID=
EBAY_CERT_ID=
