# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Era tracciato, quindi finiva anche nell'archivio pubblicato: un binario di
# coverage dentro la release che scarica l'utente.
.coverage

# Cartella di lavoro di PyInstaller
build/

# Virtual environment
.venv/

# Environment / secrets
.env
.env.local
.streamlit/secrets.toml

# GitHub skills directory
.github/skills

# Skills lock file
skills-lock.json
.agents/
.claude/

# Obsoleti / dirs di lavoro
/screen
/temp
/stitch
/screenshots
/fix
.playwright-mcp
google stitch

# Runtime data (sensibili)
.auth_sessions.json
data/auth_sessions.json

# Dati utente / runtime rigenerabili (knowledge_base.json resta come seed)
data/search_history.json
data/kb_unknown_items.json
data/search_cache.json
data/watchlist.json
data/price_history.json

# Database SQLite dell'app (dati runtime). `-wal` e `-shm` sono i file
# ausiliari del journal WAL: vanno ignorati insieme al database.
data/deal_finder.db
data/deal_finder.db-wal
data/deal_finder.db-shm
# JSON legacy rinominati dopo l'import automatico in SQLite
data/*.json.migrated
# Log e archivi scaricati dall'aggiornatore: nascono al primo avvio.
data/logs/
data/aggiornamenti/
data/aggiornamento.lock
data/local_secrets.json

# Note operative di sessione e istruzioni per agenti AI: utili in locale, ma
# rumore per chi apre il repo (e in italiano). L'architettura pubblica sta in
# ARCHITECTURE.md, la roadmap nella tabella "Sources" del README.
HANDOFF.md
APPUNTI.md
TODO.md
CLAUDE.md
tests/CLAUDE.md
.streamlit/CLAUDE.md
.github/copilot-instructions.md

# Artefatto Windows (nome device riservato)
nul

# ZIP di release generati localmente
dist/

# Artefatti di build/install (`pip install -e .`)
*.egg-info/

# Report markdown generato dall'auto-update della knowledge base
data/kb_update_report.md

# Artefatti probe real-network (dump rigenerabili, possono contenere dati scrapati)
tests/probe_siti_results.json
report_siti.md
