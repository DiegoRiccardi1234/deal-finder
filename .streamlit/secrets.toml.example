# Copia questo file in .streamlit/secrets.toml e compila i valori.
# Il file reale (secrets.toml) è in .gitignore e NON va mai committato.

# Provider AI attivo: cerebras | groq | openai | openrouter | anthropic | gemini
AI_PROVIDER = "cerebras"

# Imposta SOLO le chiavi dei provider che vuoi usare (almeno una).
CEREBRAS_API_KEY = ""      # https://cloud.cerebras.ai
GROQ_API_KEY = ""          # https://console.groq.com
OPENAI_API_KEY = ""        # https://platform.openai.com
OPENROUTER_API_KEY = ""    # https://openrouter.ai
ANTHROPIC_API_KEY = ""     # https://console.anthropic.com
GEMINI_API_KEY = ""        # https://aistudio.google.com

# Password per accedere alla dashboard
APP_PASSWORD = "cambiami"

# eBay Browse API (opzionale: senza, eBay usa fallback HTML)
EBAY_APP_ID = ""
EBAY_CERT_ID = ""
